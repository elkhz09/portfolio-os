# ─────────────────────────────────────────────────────────────────────────────
# Portfolio OS — environment configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# --- Telegram bot ---
# 1. Open Telegram and message @BotFather
# 2. Send /newbot and follow the prompts
# 3. Copy the token BotFather gives you here
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Your Telegram user ID (get it by messaging @userinfobot)
# Comma-separated for multiple users. Leave blank to allow anyone (not recommended).
TELEGRAM_ALLOWED_USER_IDS=123456789

# --- Database ---
DATABASE_URL=sqlite:///./portfolio.db

# --- App behaviour ---
PAPER_MODE=true          # true = paper trading only (recommended to start)
LOG_LEVEL=INFO
SECRET_KEY=change-me     # used for any future signed tokens

# --- Tradable allowlist (optional) ---
# Comma-separated tickers. Leave blank to allow any ticker.
# TRADABLE_ALLOWLIST=AAPL,SPY,GLD,TLT,QQQ,IWM,EEM,FXI,KWEB,XLE

# --- Optional: market data (not required for paper mode) ---
# ALPHA_VANTAGE_API_KEY=
# POLYGON_API_KEY=
